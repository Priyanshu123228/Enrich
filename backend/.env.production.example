# ==============================================================================
# ENRICH SALON BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Configure these variables in Render Dashboard > Environment Variables

# Server Environment
PORT=5000
NODE_ENV=production

# Client Domain (Vercel Frontend URL - Comma-separated if multiple domains)
CLIENT_URL=https://enrich-mu.vercel.app,https://yourdomain.com

# MongoDB Atlas Production Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxx.mongodb.net/Enrich?retryWrites=true&w=majority&appName=Cluster0

# Authentication (JWT Secret - Use a cryptographically secure 64-char random string)
JWT_SECRET=production_ultra_secure_jwt_secret_key_at_least_64_characters_long
JWT_EXPIRES_IN=7d

# OTP & Verification Lifespan
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=45

# Cloudinary Media Storage (Production Credentials)
CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret

# Razorpay Online Payment Gateway (Production Live Mode)
# Live keys start with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_CURRENCY=INR

# ==============================================================================
# Email Service Configuration (HTTPS REST API - Recommended for Render Cloud)
# ==============================================================================
# Primary Option: Brevo (Sendinblue) API - 300 free emails/day to ANY email address worldwide
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=enrichparlour1212@gmail.com

# Secondary Option: Resend API - 100 free emails/day
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=onboarding@resend.dev

# Fallback Option: Nodemailer SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=enrichparlour1212@gmail.com
EMAIL_PASSWORD=your_16_char_google_app_password
EMAIL_FROM="Enrich Salon" <enrichparlour1212@gmail.com>
EMAIL_FROM_NAME="Enrich Salon"
EMAIL_FROM_ADDRESS=enrichparlour1212@gmail.com

# SMS OTP Provider ('twilio', 'msg91', or 'simulated')
SMS_PROVIDER=simulated
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
