# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Enrich?retryWrites=true&w=majority

# Client URL for CORS Whitelist
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets (Use a 64+ char random string in production)
JWT_SECRET=your_strong_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# Email Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="Enrich Salon" <enrichparlour1212@gmail.com>
# Alternate SMTP Aliases
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# SMS OTP Provider Configuration (Options: twilio | msg91 | simulated)
SMS_PROVIDER=twilio

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 SMS Configuration
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=ENRICH
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

